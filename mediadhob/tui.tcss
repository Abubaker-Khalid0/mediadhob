/* ══════════════════════════════════════════════════════════════════════════
   MEDIADHOB TUI — torlink-inspired dark theme
   Dark background, purple/blue accents, bordered panels
   ══════════════════════════════════════════════════════════════════════════ */

Screen {
    background: #0f0f1a;
    color: #c0caf5;
}

/* ── App Layout ────────────────────────────────────────────────────────── */

#app-layout {
    height: 1fr;
}

/* ── Sidebar ───────────────────────────────────────────────────────────── */

#sidebar {
    width: 22;
    background: #0f0f1a;
    padding: 1 0 1 1;
}

#sidebar-brand {
    height: 3;
    padding: 0 1;
    content-align: left middle;
}

.nav-item {
    height: 2;
    background: transparent;
    color: #a9b1d6;
    border: none;
    padding: 0 1;
    text-align: left;
    width: 100%;
    min-width: 18;
}

.nav-item:hover {
    color: #7dcfff;
    background: #1a1b26;
}

.nav-item:focus {
    color: #7dcfff;
    background: #1a1b26;
}

.nav-item.-active {
    color: #7dcfff;
    background: #1a1b26;
    text-style: bold;
}

.nav-spacer {
    height: 2;
}

/* ── Main Content ──────────────────────────────────────────────────────── */

#main-content {
    padding: 0 2 0 1;
}

/* ── Banner ────────────────────────────────────────────────────────────── */

#banner {
    height: auto;
    max-height: 9;
    padding: 0 0 1 0;
}

/* ── URL Input Box ─────────────────────────────────────────────────────── */

#url-box {
    height: 5;
    border: solid #5d7bf0;
    background: #0f0f1a;
    padding: 0 1;
    margin-bottom: 1;
}

#url-box:focus-within {
    border: solid #7aa2f7;
}

#url-label {
    height: 1;
    padding: 0 0;
}

#url-input {
    background: #0f0f1a;
    color: #c0caf5;
    border: none;
    padding: 0 1;
}

#url-input:focus {
    border: none;
}

Input {
    background: #0f0f1a;
    border: none;
}

Input:focus {
    border: none;
}

Input > .input--cursor {
    color: #7dcfff;
}

/* ── Downloads Table Box ───────────────────────────────────────────────── */

#table-box {
    border: solid #5d7bf0;
    background: #0f0f1a;
    padding: 0 1;
    height: 1fr;
    margin-bottom: 1;
}

#table-title {
    height: 1;
    padding: 0;
}

#table-subtitle {
    height: 1;
    padding: 0 0 0 0;
}

#downloads-table {
    height: 1fr;
}

DataTable {
    background: #0f0f1a;
    color: #a9b1d6;
    height: 1fr;
}

DataTable > .datatable--header {
    background: #1a1b26;
    color: #565f89;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #292e42;
    color: #7dcfff;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: #1f2335;
}

DataTable > .datatable--even-row {
    background: #12121f;
}

/* ── Log Panel ─────────────────────────────────────────────────────────── */

#log-panel {
    height: 8;
    min-height: 6;
    max-height: 10;
    border: solid #3b4261;
    background: #0f0f1a;
    padding: 0 1;
}

RichLog {
    background: #0f0f1a;
    color: #a9b1d6;
    scrollbar-size: 1 1;
}

/* ── Footer ────────────────────────────────────────────────────────────── */

Footer {
    background: #1a1b26;
    color: #565f89;
}

Footer > .footer--key {
    background: #292e42;
    color: #c0caf5;
    text-style: bold;
}

Footer > .footer--description {
    color: #565f89;
}

/* ── Scrollbar styling ─────────────────────────────────────────────────── */

* {
    scrollbar-background: #1a1b26;
    scrollbar-color: #3b4261;
    scrollbar-color-hover: #5d7bf0;
    scrollbar-color-active: #7aa2f7;
}
